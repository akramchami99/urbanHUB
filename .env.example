# Copier ce fichier en .env puis remplir les valeurs (le .env ne doit JAMAIS être partagé / commité)

MINIO_ROOT_USER=urbanhub
MINIO_ROOT_PASSWORD=urbanhub-local-change-me
# Sur Windows / hors Docker : localhost. Compose utilise automatiquement http://minio:9000.
S3_ENDPOINT_URL=http://localhost:9002
S3_ACCESS_KEY_ID=urbanhub
S3_SECRET_ACCESS_KEY=urbanhub-local-change-me
S3_REGION=us-east-1
S3_BUCKET=urbanhub


# Bronze obligatoire dans MinIO pour les services Compose
RAW_STORAGE=minio

# --- Partie 3 : OpenAQ ---
OPENAQ_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
POLL_INTERVAL_MINUTES=10
BACKFILL_DAYS=30
# Rayon de recherche des capteurs autour de chaque ville (max 25000 m imposé par OpenAQ)
CITY_RADIUS_M=25000

LOG_LEVEL=INFO

MINIO_API_PORT=9002

# Apache Iceberg catalog (Docker overrides the endpoint to nessie:19120)
ICEBERG_CATALOG_URI=http://localhost:19120/iceberg
LAKE_TABLE_FORMAT=iceberg
